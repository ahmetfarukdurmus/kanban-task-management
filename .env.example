# ─────────────────────────────────────────────────────────────────────
# .env.example – copy to .env and fill in your own values.
# NEVER commit the actual .env file to version control.
#
# Generate a secure JWT secret:
#   openssl rand -base64 64
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kanban_db
DB_USER=kanban_user
DB_PASS=kanban_pass

# JWT (MUST be changed in production – min 256-bit base64-encoded string)
JWT_SECRET=CHANGE_ME_use_openssl_rand_-base64_64_to_generate
JWT_EXPIRATION_MS=86400000

# CORS (comma-separated allowed origins for local dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend server port
SERVER_PORT=8080

# Postgres Docker image
POSTGRES_VERSION=16-alpine
